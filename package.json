{
  "name": "nascitara",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "NasciTara \u2014 stima del peso, del percentile e della lunghezza del nascituro combinando piu ecografie.",
  "scripts": {
    "dev": "vite",
    "dev:test": "node tools/prepare-ocr.mjs && vite --mode test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prebuild": "node tools/prepare-ocr.mjs",
    "predev": "node tools/prepare-ocr.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
